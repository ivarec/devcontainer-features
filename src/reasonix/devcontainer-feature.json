{
    "id": "reasonix",
    "version": "0.0.2",
    "name": "reasonix",
    "description": "Installs the Reasonix coding agent toolset.",
    "keywords": [
        "ai",
        "cli"
    ],
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "proposals": [
                "latest",
                "1.21.3"
            ],
            "description": "reasonix version to install. Use 'latest' to install the latest GitHub release."
        }
    },
    "containerEnv": {
        "DO_NOT_TRACK": "1",
        "REASONIX_TELEMETRY": "0"
    }
}